{
    "version": 1,
    "excludeLodsFromVanillaDepth": true,
    "opaqueDrawBuffers": [1, 2, 3, 4],
    "translucentDrawBuffers": [9, 10, 11],
    "blending": {
        "-1": "off",
        "0": "ONE ONE_MINUS_SRC_ALPHA ONE ONE_MINUS_SRC_ALPHA"
    },
    "useViewportDims": true,
    "uniforms": [
        "gbufferModelView",
        "gbufferModelViewInverse",
        "gbufferProjection",
        "gbufferProjectionInverse",
        "gbufferPreviousModelView",
        "gbufferPreviousProjection",
        "shadowModelView",
        "shadowModelViewInverse",
        "shadowProjection",
        "shadowProjectionInverse",
        "cameraPosition",
        "previousCameraPosition",
        "near",
        "far",
        "frameTime",
        "frameTimeCounter",
        "frameCounter",
        "sunAngle",
        "sunPosition",
        "moonPosition",
        "upPosition",
        "rainStrength",
        "wetness",
        "thunderStrength",
        "worldTime",
        "worldDay",
        "moonPhase",
        "isEyeInWater",
        "blindness",
        "nightVision",
        "darknessFactor",
        "eyeAltitude",
        "eyeBrightness",
        "eyeBrightnessSmooth",
        "heldBlockLightValue",
        "temperature",
        "rainfall",
        "biome",
        "biome_category",
        "biome_precipitation",
        "seaLevel",
        "alphaTestRef",
        "screenBrightness",
        "viewWidth",
        "viewHeight"
    ],
    "samplers": [
        "noisetex",
        "depthtex0",
        "depthtex1",
        "colortex1",
        "colortex2",
        "colortex3",
        "colortex4",
        "colortex14"
    ]
}
